{
  "name": "media-workbench-ytdl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Standalone microservice that fetches YouTube video/audio via yt-dlp for the Media Workbench frontend.",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "youtube-dl-exec": "^3.0.26"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "youtube-dl-exec"]
  }
}
